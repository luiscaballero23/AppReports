<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppReports.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppReports.Views"
    Shell.BackgroundColor="#ea6e12">

    <FlyoutItem Title="Reportes">
        <ShellContent
            Title="Reportes"
            ContentTemplate="{DataTemplate views:ReportTypeListPage}"
            Route="ReportTypeListPage" />
    </FlyoutItem> 

    <MenuItem Text="Salir"
    Clicked="OnSalirClicked"
    IconImageSource="ic_logout.png" /> 
</Shell>
